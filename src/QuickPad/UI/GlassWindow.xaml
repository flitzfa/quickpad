<Window x:Class="QuickPad.UI.GlassWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickPad"
        Width="520" Height="320"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" AllowsTransparency="False"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Foreground="{DynamicResource Text.Primary}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
    <!-- SingleBorderWindow, not None: DWM only draws the acrylic backdrop for a window with a caption style.
         WindowChrome removes the title bar and frame, so it still looks borderless. -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" Background="{DynamicResource Glass.Background}"
            BorderBrush="{DynamicResource Glass.Border}" BorderThickness="1" CornerRadius="8">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" />
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: file icon + name + folder -->
            <Grid Grid.Row="0" Margin="18,16,18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource Accent.Soft}"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                               Foreground="{DynamicResource Accent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="FileName" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="FolderName" FontSize="11.5" Margin="0,1,0,0"
                               Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <!-- Content host: preview now; Task 8 swaps in the editor, search bar and inline dialogs here. -->
            <Grid x:Name="ContentHost" Grid.Row="1" Margin="18,4,18,10" ClipToBounds="True">
                <TextBlock x:Name="PreviewText" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                           LineHeight="19" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="Notice" Visibility="Collapsed" FontSize="14" Margin="0,18"
                           Foreground="{DynamicResource Text.Secondary}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
            </Grid>

            <!-- Footer -->
            <TextBlock x:Name="Footer" Grid.Row="2" Margin="18,0,18,14" FontSize="11.5"
                       Foreground="{DynamicResource Text.Secondary}" />
        </Grid>
    </Border>
</Window>
