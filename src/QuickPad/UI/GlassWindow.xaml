<Window x:Class="QuickPad.UI.GlassWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:QuickPad.UI"
        Title="QuickPad"
        Width="520" Height="320"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" AllowsTransparency="False"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Foreground="{DynamicResource Text.Primary}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
    <!-- SingleBorderWindow, not None: DWM only draws the acrylic backdrop for a window with a caption style.
         WindowChrome removes the title bar and frame, so it still looks borderless. -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="BareTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="SelectionOpacity" Value="0.35" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <!-- Slim rounded thumb, no track or arrows: the default Aero scrollbar is an opaque grey slab on glass. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Margin="3" CornerRadius="2" Opacity="0.45"
                                                    Background="{DynamicResource Text.Secondary}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="MinHeight" Value="10" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Background="{DynamicResource Glass.Background}"
            BorderBrush="{DynamicResource Glass.Border}" BorderThickness="1" CornerRadius="8">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" />
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: file icon + name + folder -->
            <Grid Grid.Row="0" Margin="18,16,18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource Accent.Soft}"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                               Foreground="{DynamicResource Accent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="FileName" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="FolderName" FontSize="11.5" Margin="0,1,0,0"
                               Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <!-- Save confirmation: flashes in and fades out. -->
                <TextBlock x:Name="SavedMark" Grid.Column="2" Text="&#xE73E;" Opacity="0" Margin="10,0,2,0"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                           Foreground="{DynamicResource Success}" VerticalAlignment="Center" />
            </Grid>

            <!-- Content host: search bar on top; the preview, the notice or the editor below. -->
            <Grid x:Name="ContentHost" Grid.Row="1" Margin="18,4,18,10" ClipToBounds="True" Background="Transparent"
                  MouseLeftButtonUp="OnContentClick">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="SearchBar" Visibility="Collapsed" Margin="0,0,0,8" Padding="10,5" CornerRadius="10"
                        Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Surface.Border}" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="13" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="SearchStatus" DockPanel.Dock="Right" FontSize="11.5" Margin="8,0,0,0"
                                   Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                        <Grid>
                            <TextBlock x:Name="SearchHint" Text="Buscar" Foreground="{DynamicResource Text.Secondary}"
                                       IsHitTestVisible="False" VerticalAlignment="Center" />
                            <TextBox x:Name="SearchBox" Style="{StaticResource BareTextBox}" VerticalAlignment="Center"
                                     PreviewKeyDown="OnSearchKeyDown" TextChanged="OnSearchTextChanged" />
                        </Grid>
                    </DockPanel>
                </Border>
                <TextBlock x:Name="PreviewText" Grid.Row="1" FontFamily="Cascadia Mono, Consolas" FontSize="13" Cursor="IBeam"
                           LineHeight="19" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <TextBox x:Name="Editor" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource BareTextBox}" Margin="-2,0,0,0"
                         FontFamily="Cascadia Mono, Consolas" FontSize="13"
                         TextBlock.LineHeight="19" TextBlock.LineStackingStrategy="BlockLineHeight"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         SelectionChanged="OnEditorViewChanged" ScrollViewer.ScrollChanged="OnEditorViewChanged" />
                <!-- WPF paints an unfocused selection in a fixed system grey that vanishes on glass,
                     so the current search match is marked here while the search box has the focus. -->
                <Canvas x:Name="MatchLayer" Grid.Row="1" IsHitTestVisible="False" ClipToBounds="True">
                    <Border x:Name="MatchMark" Visibility="Collapsed" CornerRadius="3" Opacity="0.35"
                            Background="{DynamicResource Accent}" />
                </Canvas>
                <TextBlock x:Name="Notice" Grid.Row="1" Visibility="Collapsed" FontSize="14" Margin="0,18"
                           Foreground="{DynamicResource Text.Secondary}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
            </Grid>

            <!-- Footer -->
            <TextBlock x:Name="Footer" Grid.Row="2" Margin="18,0,18,14" FontSize="11.5"
                       Foreground="{DynamicResource Text.Secondary}" />

            <ui:InlineDialog x:Name="Dialog" Grid.RowSpan="3" />
        </Grid>
    </Border>
</Window>
